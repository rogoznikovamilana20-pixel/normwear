APP_ENV=development
# Локально: sqlite+aiosqlite:///normwear.db  |  На Render: подставится postgres из render.yaml
DATABASE_URL=sqlite+aiosqlite:///normwear.db
# Оставь пустым если нет Redis — бот будет на MemoryStorage (ок для старта до 500 клиентов)
REDIS_URL=
SHOP_BOT_TOKEN=
ADMIN_BOT_TOKEN=
SHOP_CHANNEL_ID=-1000000000000
SHOP_CHANNEL_USERNAME=normwear_shop
SHOP_USERNAME=norm_shop_bot
SUPPLIER_CHANNEL_USERNAME=optobaza
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
SUPPLIER_SESSION_STRING=
TELEGRAM_PROXY_URL=
CURRENCY=RUB
DEFAULT_MARGIN_PCT=35
PRICE_REVIEW_THRESHOLD=
MINIAPP_URL_TEMPLATE=
TELEGRAM_PAYMENT_PROVIDER_TOKEN=
# manual = менеджер пишет реквизиты СБП вручную (лучше для старта, 0% комиссии)
SBP_PROVIDER=manual
SBP_PAYMENT_URL=
ADMIN_TELEGRAM_IDS=123456789
AUTO_PUBLISH=false
RUN_BOTS=true
BASE_PORT=8000
# PORT — задаёт Render/Railway автоматически, не трогай
# YANDEX_PUBLIC_KEY — публичная ссылка на папку с фото
YANDEX_PUBLIC_KEY=https://disk.yandex.ru/d/e4YGRLhebhBoVA